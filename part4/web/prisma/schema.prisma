model RISK_FACTOR {
  RiskFactorID        Int              @id(map: "RISK_FACTOR_PK") @default(autoincrement())
  AgeBand             String           @db.VarChar(10)
  Gender              String           @db.VarChar(1)
  SmokingStatus       String?          @db.VarChar(10)
  DiabetesStatus      String?          @db.VarChar(10)
  BMIBand             String?          @db.VarChar(10)
  MortalityMultiplier Decimal          @db.Decimal(6, 3)
  DerivedFromRunID    Int
  RATE                RATE[]
  DATA_REFRESH_RUN    DATA_REFRESH_RUN @relation(fields: [DerivedFromRunID], references: [RunID], onUpdate: NoAction, map: "RISK_FACTOR_RUN_FK")

  @@unique([AgeBand, Gender, SmokingStatus, DiabetesStatus, BMIBand, DerivedFromRunID], map: "RISK_FACTOR_UN")
}

model RISK_IMPROVEMENT {
  ImprovementID       Int                 @id(map: "RISK_IMPROVEMENT_PK") @default(autoincrement())
  EnrollmentID        Int
  MeasureDate         DateTime            @db.Date
  MeasureType         String              @db.VarChar(20)
  MeasureValue        Decimal?            @db.Decimal(8, 2)
  BaselineValue       Decimal?            @db.Decimal(8, 2)
  ImprovementPct      Decimal?            @db.Decimal(5, 2)
  WELLNESS_ENROLLMENT WELLNESS_ENROLLMENT @relation(fields: [EnrollmentID], references: [EnrollmentID], onUpdate: NoAction, map: "RIMP_ENROLL_FK")
}

model STG_BRFSS {
  StgBRFSSID     Int      @id(map: "STG_BRFSS_PK") @default(autoincrement())
  SourceYear     Int
  AgeBand        String   @db.VarChar(10)
  Gender         String   @db.VarChar(1)
  SmokingStatus  String?  @db.VarChar(10)
  DiabetesStatus String?  @db.VarChar(10)
  BMIBand        String?  @db.VarChar(10)
  ExerciseFreq   String?  @db.VarChar(10)
  PrevalenceRate Decimal? @db.Decimal(6, 4)
  LoadDate       DateTime @db.Date
  SourceFile     String?  @db.VarChar(255)
}

model STG_BRFSS_RECORD {
  StgBRFSSRecordID Int      @id(map: "STG_BRFSS_RECORD_PK") @default(autoincrement())
  SourceYear       Int
  AgeBand          String?  @db.VarChar(10)
  Gender           String?  @db.VarChar(1)
  SmokingStatus    String?  @db.VarChar(10)
  DiabetesStatus   String?  @db.VarChar(10)
  BMIBand          String?  @db.VarChar(10)
  ExerciseFreq     String?  @db.VarChar(10)
  BMIValue         Decimal? @db.Decimal(5, 2)
  LoadDate         DateTime @db.Date
  SourceFile       String   @db.VarChar(255)
}

model STG_MORTALITY {
  StgMortalityID Int      @id(map: "STG_MORTALITY_PK") @default(autoincrement())
  SourceYear     Int
  AgeBand        String   @db.VarChar(10)
  Gender         String   @db.VarChar(1)
  ConditionFlag  String?  @db.VarChar(10)
  MortalityRate  Decimal? @db.Decimal(8, 6)
  LifeExpectancy Decimal? @db.Decimal(5, 2)
  LoadDate       DateTime @db.Date
  SourceFile     String?  @db.VarChar(255)
}

model STG_NHANES {
  StgNHANESID       Int      @id(map: "STG_NHANES_PK") @default(autoincrement())
  SourceCycle       String   @db.VarChar(10)
  AgeBand           String   @db.VarChar(10)
  Gender            String   @db.VarChar(1)
  DiabetesBiomarker String?  @db.VarChar(20)
  BMIMeasured       Decimal? @db.Decimal(5, 2)
  LoadDate          DateTime @db.Date
  SourceFile        String?  @db.VarChar(255)
}

model WellnessActivity {
  ActivityID          Int                 @id(clustered: false, map: "WELLNESS_ACTIVITY_PK") @default(autoincrement())
  EnrollmentID        Int
  ActivityDate        DateTime            @db.Date
  ActivityType        String?             @db.VarChar(20)
  VerifiedFlag        String?             @db.Char(1)
  WELLNESS_ENROLLMENT WELLNESS_ENROLLMENT @relation(fields: [EnrollmentID], references: [EnrollmentID], onUpdate: NoAction, map: "WACT_ENROLL_FK")

  @@index([ActivityDate, ActivityID], map: "CIX_WELLNESS_ACTIVITY_ActivityDate_ActivityID", clustered: true)
  @@index([EnrollmentID, ActivityDate], map: "IX_WELLNESS_ACTIVITY_EnrollmentID_ActivityDate")
  @@map("WELLNESS_ACTIVITY")
}

model WELLNESS_ENROLLMENT {
  EnrollmentID      Int                 @id(map: "WELLNESS_ENROLLMENT_PK") @default(autoincrement())
  ContractID        Int
  WellnessProgramID Int
  EnrollDate        DateTime            @db.Date
  Status            String              @db.VarChar(10)
  RISK_IMPROVEMENT  RISK_IMPROVEMENT[]
  WELLNESS_ACTIVITY WellnessActivity[]
  Contract          Contract            @relation(fields: [ContractID], references: [ContractID], onUpdate: NoAction, map: "WENROLL_CONTRACT_FK")
  WELLNESS_PROGRAM  WELLNESS_PROGRAM    @relation(fields: [WellnessProgramID], references: [WellnessProgramID], onUpdate: NoAction, map: "WENROLL_PROGRAM_FK")
}

model WELLNESS_PROGRAM {
  WellnessProgramID   Int                   @id(map: "WELLNESS_PROGRAM_PK") @default(autoincrement())
  ProgramName         String                @db.VarChar(60)
  PartnerGym          String?               @db.VarChar(60)
  DiscountMaxPct      Decimal?              @db.Decimal(5, 2)
  WELLNESS_ENROLLMENT WELLNESS_ENROLLMENT[]
}

model WritingNumber {
  CompanyCode           String            @db.VarChar(10)
  WritingNumber         String            @db.VarChar(15)
  AssocLastName         String?           @db.VarChar(40)
  AssocFirstName        String?           @db.VarChar(40)
  AssocMiddleInitial    String?           @db.VarChar(2)
  AssocSuffix           String?           @db.VarChar(10)
  AssocDOB              DateTime?         @db.Date
  IssueDate             DateTime?         @db.Date
  Status                String?           @db.VarChar(10)
  VestedFlag            String?           @db.Char(1)
  TerminationDate       DateTime?         @db.Date
  LicenseState          String?           @db.VarChar(2)
  LicenseNumber         String?           @db.VarChar(20)
  LineOfBusiness        String?           @db.VarChar(20)
  AssociateID           Int
  WritingNumberID       Int               @id(map: "WritingNumber_PK")
  Associate_AssociateID Int
  ManagerContract       ManagerContract[]
  Associate             Associate         @relation(fields: [Associate_AssociateID], references: [AssociateID], onUpdate: NoAction, map: "WritingNumber_Associate_FK")

  @@unique([CompanyCode, WritingNumber], map: "WritingNumber_CompanyCode_WritingNumber_UN")
}
